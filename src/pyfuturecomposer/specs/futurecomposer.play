// Future Composer's play call. The tempo counts down once per call; on a row each voice counts
// its note's duration down and, out of rows, reads the next note: the orderlist names a pattern
// ($FE ends the song, $FF restarts the voice, $80.. transpose, $40.. repeat), the pattern's
// commands set slide, instrument and duration until a note starts the sound. Every other call
// the voice plays its instrument's modulation: vibrato or arpeggio, slide, pulse sweep, filter
// program, and the waveform and pitch programs.
spec futurecomposer;

layout {
  freq_lo, freq_hi, seq_lo, seq_hi, pat_ptr, instr, mod, voice_base, tempo, volume, pw_step,
  filter, wave_arp, arp_delay, filt_lo, filt_hi, wave_prog_ptr: addr;
  has_state: flag;
  init_countdown, init_play_state, init_route, init_filter_voice, init_slide_rate, init_slide_delay:
  byte;
  init_seqpos, init_patpos, init_left, init_dur, init_wave, init_ctrl, init_key, init_instr,
  init_freq, init_slide, init_ticks, init_pw, init_pulse, init_trans, init_vib_dir, init_vib_pos,
  init_arp_pos, init_cutoff, init_pw_up, init_repeat: list;
}

const FILTER_CUTOFF = 0x16;
const FILTER_ROUTE = 0x17;
const VOLUME = 0x18;
const FREQ = 0;
const PW = 2;
const CTRL = 4;
const AD = 5;
const SR = 6;

event pattern_end: note;
event next_entry: pattern_end;
event order_byte: note;
event pattern_byte: note;

cell sid: u8[0x19] @ 0xD400 out;

// Song data: the orderlists, the patterns' pointers and the instruments with their modulation.
cell orderptr: u16[3] @ (L.seq_lo, L.seq_hi) ro;
cell patptr: u16[64] @ L.pat_ptr ro;
table instrument @ L.instr stride 8 { pulse: u8; wave: u8; ad: u8; sr: u8; }
table modulation @ L.mod stride 8 { vib: u8; sweep: u8; flags: u8; }
cell voice_base: u8[3] @ L.voice_base ro;
cell speed: u8 @ L.tempo ro;
cell volume: u8 @ L.volume;

// The player's tables: note frequencies, the pulse sweep programs (limit, step, limit, step),
// the filter program, the waveform cycle, the arpeggio steps (step 0 is data, steps 1 and 2 are
// stored from the instrument's vibrato byte) and the pointers of the waveform and pitch programs.
cell freq_lo: u8[256] @ L.freq_lo ro notes(lo, 0);
cell freq_hi: u8[256] @ L.freq_hi ro notes(hi, 0);
table pw_program @ L.pw_step stride 4 { until: u8; step: u8; then_until: u8; then_step: u8; }
cell filt: u8[12] @ L.filter ro;
cell wave_cycle: u8[4] @ L.wave_arp ro;
cell arp: u8[3] @ L.arp_delay ro;
cell arp_1: u8 @ L.filt_lo;
cell arp_2: u8 @ L.filt_hi;
cell wave_ctrl_ptr: u16[16] @ (L.wave_prog_ptr, L.wave_prog_ptr + 2) ro;
cell wave_pitch_ptr: u16[16] @ (L.wave_prog_ptr + 4, L.wave_prog_ptr + 6) ro;
table wave_ctrl via wave_ctrl_ptr stride 1 { b: u8; }
table wave_pitch via wave_pitch_ptr stride 1 { b: u8; }

// Shared state: the tempo counter, the song state ($02 ended, $01 restart), the filter's routing
// and owning voice, and the slide command's rate and delay.
state countdown: u8 = L.init_countdown;
state play_state: u8 = L.init_play_state;
state route: u8 = L.init_route;
state filter_voice: u8 = L.init_filter_voice;
state slide_rate: u16 = L.init_slide_rate;
state slide_delay: u8 = L.init_slide_delay;

machine clock {
  signal due: bool = false;

  counter beat: countdown { on frame -= 1; reload speed; wrap when neg(countdown - 1) -> row; }
  handler on_row on row { due := true; }

  step {
    if L.has_state {
      if play_state == 2 {
        finish;
      }
      if play_state == 1 {
        for k in 0..3 {
          voice[k].seqpos := 0;
          voice[k].patpos := 0;
          voice[k].left := 0;
          voice[k].key := 0;
          voice[k].ticks := 0;
        }
        play_state := 0;
        finish;
      }
    }
    sid[VOLUME] := volume;
    fire frame;
  }
}

machine voice[x in 0..3] {
  state seqpos: u8 = L.init_seqpos[x];
  state patpos: u8 = L.init_patpos[x];
  state left: u8 = L.init_left[x];
  state dur: u8 = L.init_dur[x];
  state wave: u8 = L.init_wave[x];
  state ctrl: u8 = L.init_ctrl[x];
  state key: u8 = L.init_key[x];
  state instr: u8 = L.init_instr[x];
  state freq: u16 = L.init_freq[x];
  state slide: u8 = L.init_slide[x];
  state ticks: u8 = L.init_ticks[x];
  state pw: u16 = L.init_pw[x];
  state pulse: u8 = L.init_pulse[x];
  state trans: u8 = L.init_trans[x];
  state vib_dir: u8 = L.init_vib_dir[x];
  state vib_pos: u8 = L.init_vib_pos[x];
  state arp_pos: u8 = L.init_arp_pos[x];
  state cutoff: u8 = L.init_cutoff[x];
  state pw_up: u8 = L.init_pw_up[x];
  state repeat: u8 = L.init_repeat[x];

  // The voice's SID registers start at reg; read is set once the voice has read a note.
  signal reg: u16 = 0;
  signal read: bool = false;

  counter age: ticks { on frame += 1; on note reset; }
  counter remaining: left { on row -= 1; reload 0; wrap when neg(left - 1) -> note; }
  counter again: repeat { on pattern_end -= 1; wrap when repeat == 0 -> next_entry; }

  // The orderlist: transposes and repeats take effect as they are passed; a pattern, $FE and
  // $FF stop the cursor.
  cursor orderlist {
    table @ orderptr[x] width 1;
    pos seqpos;
    on order_byte step;
    match c0 {
      0x80..0xFD => value(trans = c0 & 0x1F);
      0x40..0x7F => value(repeat = c0 & 0x3F);
      _ => stop;
    }
  }

  // A pattern: a note ends the read; the others set the voice's slide, instrument and duration.
  cursor pattern {
    table @ patptr[orderlist.c0] width 2;
    pos patpos;
    on pattern_byte step; on pattern_end reset;
    match c0 {
      0xF0..0xFF => end take 2;
      0xE0..0xEF => value(slide = 1 when (c0 & 1) == 0, slide = 2 when (c0 & 1) == 1,
                          slide_rate.hi = (c0 & 0x0E) >> 1, slide_rate.lo = c1 & 0xF0,
                          slide_delay = c1 & 0x0F) take 2;
      0xC0..0xDF => value(instr = c0 & 0x1F) take 1;
      0x80..0xBF => value(dur = c0 & 0x3F) take 1;
      _ => end take 1;
    }
  }

  handler to_next on next_entry {
    seqpos += 1;
  }

  handler fetch on note {
    read := true;
    next_note();
  }

  handler hold on row {
    if !read && ticks != 0 {
      ctrl := wave & 0xFE;
    }
  }

  proc next_note() {
    let seeking = true;
    while seeking bound 1024 {
      let found = false;
      react orderlist on order_byte() -> found;
      if found {
        match orderlist.c0 {
          0xFE => {
            for k in 0..0x18 {
              sid[k] := 0;
            }
            play_state := 2;
            if L.has_state {
              finish;
            }
            return;
          }
          0xFF => {
            seqpos := 0;
            patpos := 0;
            route := 0;
          }
          _ => seeking := false;
        }
      }
    }
    slide := 0;
    arp_pos := 3;
    read_pattern();
    sid[reg + CTRL] := ctrl;
  }

  // A pattern is read a command at a time up to a note. What follows a slide may be an
  // instrument, a duration or a note, and after an instrument a duration or a note; any other
  // byte there is the note.
  proc read_pattern() {
    let after = 0;
    let walking = true;
    while walking bound 600 {
      let first = pattern.c0;
      let plain = after != 0 && first >= ite(after == 2, 0xC0, 0xE0);
      let n = ite(first >= 0xF0 && !plain, pattern.c1, first);
      let noted = plain;
      if plain {
        patpos += 1;
      } else {
        react pattern on pattern_byte() -> noted;
      }
      if noted {
        start_note(n, plain || first < 0xF0);
        walking := false;
      }
      after := ite(noted, 0, ite((first & 0xF0) == 0xE0, 1, ite((first & 0xE0) == 0xC0, 2, 0)));
      if (first & 0xF0) != 0xE0 || plain {
        if pattern.ahead == 0xFF {
          fire pattern_end;
          walking := false;
        }
      }
    }
  }

  proc put_word(at: u8, value: u16) {
    sid[reg + at] := lo(value);
    sid[reg + at + 1] := hi(value);
  }

  proc start_note(n: u8, sounds: bool) {
    left := dur;
    key := n + trans;
    freq := word(freq_lo[key], freq_hi[key]);
    put_word(FREQ, freq);
    if sounds {
      sid[reg + AD] := instrument[instr].ad;
      sid[reg + SR] := instrument[instr].sr;
      wave := instrument[instr].wave;
      ctrl := wave;
      pulse := instrument[instr].pulse;
      pw := u16(pulse & 0x0F) << 8;
      put_word(PW, pw);
      pw_up := 1;
    }
  }

  // A call that reads no note: the instrument's modulation, from vibrato or the arpeggio steps
  // through to the waveform, ending with the control register.
  proc modulate() {
    let vib = modulation[instr].vib;
    let sweep = modulation[instr].sweep;
    let flags = modulation[instr].flags;
    if (flags & 0x14) == 0 && vib != 0 {
      vibrato(vib);
    } elif vib == 0 {
      arp_1 := 0x0C;
      arp_2 := 0x18;
    } else {
      arp_1 := vib >> 4;
      arp_2 := vib & 0x0F;
    }
    let diff = dur - left;
    if diff >= slide_delay && slide != 0 {
      if (slide & 3) == 1 {
        freq += slide_rate;
      } else {
        freq -= slide_rate;
      }
      put_word(FREQ, freq);
    }
    pulse_width(sweep);
    if (flags & 0x40) != 0 && ticks >= 3 {
      ctrl := wave_cycle[ticks & 3];
    }
    filter_program(flags);
    if (flags & 0x10) != 0 {
      waveform_program(vib);
    } elif (flags & 0x80) != 0 && ticks < 2 {
      put_word(FREQ, 0x4800);
      ctrl := 0x81;
    } else {
      if (flags & 0x80) != 0 {
        put_word(FREQ, freq);
        ctrl := wave & 0xFE;
      }
      if (flags & 4) != 0 {
        arp_pos -= 1;
        if neg(arp_pos) {
          arp_pos := 2;
        }
        let pitch = key + arp[arp_pos];
        put_word(FREQ, word(freq_lo[pitch], freq_hi[pitch]));
      }
    }
    sid[reg + CTRL] := ctrl;
  }

  // The vibrato sweeps the pitch a fraction of the way to the next note: a triangle of depth
  // $78 & vib, scaled down by the low three bits.
  proc vibrato(vib: u8) {
    let depth = (vib & 0x78) >> 3;
    let stepping = false;
    if vib_dir == 0 {
      stepping := true;
    } else {
      vib_pos -= 1;
      if vib_pos == 0 {
        vib_dir += 1;
        if neg(vib_dir) {
          stepping := true;
        }
      }
    }
    if stepping {
      vib_pos += 1;
      if depth < vib_pos {
        vib_pos := depth - 1;
        vib_dir -= 1;
      }
    }
    let lo0 = freq_lo[key];
    let lo1 = freq_lo[key + 1];
    let hi0 = freq_hi[key];
    let hi1 = freq_hi[key + 1];
    let borrow_lo = borrow(lo1, lo0);
    let gap = (hi1 - hi0 - u8(borrow_lo) + ticks + u8(!borrow(hi1, hi0, borrow_lo))) >> 1;
    let unit = word(lo1 - lo0, gap) >> (vib & 7);
    if ticks >= 4 {
      let swing = u16(ite(vib_pos > 0x80, 0, vib_pos)) - u16(depth >> 1);
      put_word(FREQ, word(lo0, hi0) + swing * unit);
    }
  }

  proc pulse_width(sweep: u8) {
    if sweep != 0 {
      let p = ((sweep & 7) - 1) & 0x3F;
      let step = ite(pw_program[p].until >= ticks, pw_program[p].step,
                     ite(pw_program[p].then_until >= ticks, pw_program[p].then_step, sweep & 0xFC));
      if pw_up == 0 {
        pw -= u16(step);
        if hi(pw) < 1 {
          pw_up := 1;
        }
      } else {
        pw += u16(step);
        if hi(pw) >= 0x0F {
          pw_up := 0;
        }
      }
    }
    let wobble = ite((pulse & 0x80) != 0 && (ticks & 1) != 0, 0xB0, 0);
    put_word(PW, pw + wobble);
  }

  proc set_cutoff(value: u8) {
    cutoff := value;
    sid[FILTER_CUTOFF] := value;
  }

  // The filter program, run by the voice that owns the filter, steps with the note's age: it
  // sweeps the cutoff up from its first value, then sets it for good.
  proc filter_program(flags: u8) {
    if (flags & 1) == 0 {
      if x == filter_voice {
        set_cutoff(0xFF);
      }
    } else {
      filter_voice := x;
      if ticks >= filt[11] {
        set_cutoff(filt[5]);
      } elif ticks >= filt[10] {
        set_cutoff(cutoff + filt[4]);
      } elif ticks >= filt[9] {
        set_cutoff(cutoff + filt[3]);
      } elif ticks >= filt[8] {
        set_cutoff(cutoff + filt[2]);
      } elif ticks >= filt[7] {
        set_cutoff(cutoff + filt[1]);
      } elif ticks >= filt[6] {
        let bit = ite(x == 0, 1, x << 1);
        if (route & bit) == 0 {
          sid[FILTER_ROUTE] := route + bit;
        }
        set_cutoff(filt[0]);
      }
    }
  }

  proc waveform_program(vib: u8) {
    if ticks < 0x0F {
      let program = vib & 0x0F;
      let pitch = wave_pitch[program][ticks - 1].b;
      ctrl := wave_ctrl[program][ticks - 1].b;
      if (vib & 0x10) != 0 {
        let at = key + pitch;
        put_word(FREQ, word(freq_lo[at], freq_hi[at]));
      } else {
        put_word(FREQ, word(0, pitch + 0x0D));
      }
    }
  }

  step {
    reg := voice_base[x];
    fire frame;
    if clock.due {
      fire row;
    }
    if !read {
      modulate();
    }
  }
}

schedule {
  clock;
  voice[2];
  voice[1];
  voice[0];
}
